{
  "_comment": "Dit is een VOORBEELD. Kopieer naar ~/.claude/settings.json en vul je eigen keys in.",
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-gmail"],
      "env": {
        "GMAIL_CREDENTIALS_PATH": "/pad/naar/jouw/credentials.json",
        "GMAIL_TOKEN_PATH": "/pad/naar/jouw/token.json"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-notion"],
      "env": {
        "NOTION_TOKEN": "ntn_JOUW_TOKEN_HIER"
      }
    }
  }
}
